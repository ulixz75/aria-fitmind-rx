rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ============================================================
       HELPERS
       ============================================================ */

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }

    function isActive() {
      return signedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.status == 'active';
    }

    /*
     * Checks whether the authenticated client has an
     * active-program mapping document.
     */
    function hasActiveProgramMapping() {
      return isActive()
        && exists(
          /databases/$(database)/documents/clientActivePrograms/$(request.auth.uid)
        );
    }

    /*
     * Checks whether the authenticated client is currently
     * assigned to the requested program.
     */
    function hasAssignedProgram(programId) {
      return hasActiveProgramMapping()
        && get(
          /databases/$(database)/documents/clientActivePrograms/$(request.auth.uid)
        ).data.programId == programId;
    }

    /* ============================================================
       USERS
       ------------------------------------------------------------
       Campos de plan (plan, planStatus, trialEndsAt,
       sessionsLimit, currentPeriodEnd, stripeCustomerId):
       SOLO escribibles por backend (webhook Stripe con
       Admin SDK). El dueño solo puede incrementar contadores
       de uso con tope; el resto de campos sigue la regla base.
       ============================================================ */

    function planFieldsUnchanged() {
      return request.resource.data.get('plan', null) == resource.data.get('plan', null)
        && request.resource.data.get('planStatus', null) == resource.data.get('planStatus', null)
        && request.resource.data.get('trialEndsAt', null) == resource.data.get('trialEndsAt', null)
        && request.resource.data.get('sessionsLimit', null) == resource.data.get('sessionsLimit', null)
        && request.resource.data.get('currentPeriodEnd', null) == resource.data.get('currentPeriodEnd', null)
        && request.resource.data.get('stripeCustomerId', null) == resource.data.get('stripeCustomerId', null);
    }

    function usageOnlyIncreases() {
      return request.resource.data.get('trialSecondsUsed', 0) >= resource.data.get('trialSecondsUsed', 0)
        && request.resource.data.get('trialSecondsUsed', 0) <= 60
        && request.resource.data.get('sessionsUsed', 0) >= resource.data.get('sessionsUsed', 0)
        && request.resource.data.get('sessionsUsed', 0) <= resource.data.get('sessionsLimit', 8);
    }

    /*
     * Fusión pay-first: el dueño solo puede escribir campos de plan
     * copiando VALORES IDÉNTICOS al pending que escribió el backend
     * (id = email en minúsculas). Luego el cliente elimina el pending:
     * un solo uso, sin auto-otorgamiento posible.
     */
    function copiesOwnPending() {
      return exists(/databases/$(database)/documents/stripePending/$(request.auth.token.email))
        && request.resource.data.plan == get(/databases/$(database)/documents/stripePending/$(request.auth.token.email)).data.plan
        && request.resource.data.planStatus == get(/databases/$(database)/documents/stripePending/$(request.auth.token.email)).data.planStatus
        && request.resource.data.get('trialEndsAt', null) == get(/databases/$(database)/documents/stripePending/$(request.auth.token.email)).data.get('trialEndsAt', null)
        && request.resource.data.get('trialSecondsUsed', 0) == get(/databases/$(database)/documents/stripePending/$(request.auth.token.email)).data.get('trialSecondsUsed', 0)
        && request.resource.data.get('sessionsLimit', 8) == get(/databases/$(database)/documents/stripePending/$(request.auth.token.email)).data.get('sessionsLimit', 8)
        && request.resource.data.get('sessionsUsed', 0) == get(/databases/$(database)/documents/stripePending/$(request.auth.token.email)).data.get('sessionsUsed', 0)
        && request.resource.data.get('currentPeriodEnd', null) == get(/databases/$(database)/documents/stripePending/$(request.auth.token.email)).data.get('currentPeriodEnd', null)
        && request.resource.data.get('stripeCustomerId', null) == get(/databases/$(database)/documents/stripePending/$(request.auth.token.email)).data.get('stripeCustomerId', null);
    }

    match /users/{uid} {

      allow create:
        if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'client'
        && request.resource.data.status == 'pending';

      allow read:
        if signedIn()
        && (
          request.auth.uid == uid
          || isAdmin()
        );

      allow update:
        if isAdmin()
        || (
          request.auth.uid == uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && (planFieldsUnchanged() || copiesOwnPending())
          && usageOnlyIncreases()
        );

      allow delete:
        if isAdmin();
    }

    /* ============================================================
       STRIPE PENDING
       ------------------------------------------------------------
       Pagos recibidos antes del registro (id = email en
       minúsculas). Solo lectura/eliminación del propio email;
       creación/actualización solo backend. La copia a users/
       se verifica valor por valor en copiesOwnPending().
       ============================================================ */

    match /stripePending/{id} {
      allow get, delete: if signedIn()
        && request.auth.token.email != null
        && resource.data.email == request.auth.token.email;
      allow list, create, update: if false;
    }

    /* ============================================================
       CLIENT PROFILES
       ============================================================ */

    match /clientProfiles/{uid} {

      allow read:
        if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
        );

      allow create, update:
        if isAdmin()
        || (
          isActive()
          && request.auth.uid == uid
        );

      allow delete:
        if isAdmin();
    }

    /* ============================================================
       WORKOUT SESSIONS
       ============================================================ */

    match /workoutSessions/{sessionId} {

  allow read:
    if isAdmin()
    || (
      isActive()
      && resource.data.clientId == request.auth.uid
    )
    || (
      signedIn()
      && resource.data.uid == request.auth.uid
    );

  allow create:
    if (
      isActive()
      && request.resource.data.clientId == request.auth.uid
    )
    || (
      signedIn()
      && request.resource.data.uid == request.auth.uid
    );

  allow update, delete:
    if isAdmin()
    || (
      isActive()
      && resource.data.clientId == request.auth.uid
    );

  match /sets/{setId} {

    allow read:
      if isAdmin()
      || (
        isActive()
        && get(
          /databases/$(database)/documents/workoutSessions/$(sessionId)
        ).data.clientId == request.auth.uid
      );

    allow create, update:
      if isAdmin()
      || (
        isActive()
        && get(
          /databases/$(database)/documents/workoutSessions/$(sessionId)
        ).data.clientId == request.auth.uid
      );

    allow delete:
      if isAdmin();
  }
}

    /* ============================================================
       COACH CONFIG
       ============================================================ */

    match /coachConfigs/{configId} {

      allow read:
        if isActive() || isAdmin();

      allow write:
        if isAdmin();
    }

    /* ============================================================
       EXERCISES
       ============================================================ */

    match /exercises/{exerciseId} {

      /*
       * Exercises are reference data.
       * Admins can manage them.
       * Active clients can read them.
       */

      allow read:
        if isAdmin() || isActive();

      allow create, update, delete:
        if isAdmin();
    }

    /* ============================================================
       TRAINING PROGRAMS
       ============================================================ */

    match /trainingPrograms/{programId} {

      /*
       * Admins:
       * full access.
       *
       * Clients:
       * read only their currently assigned program.
       */

      allow read:
        if isAdmin()
        || hasAssignedProgram(programId);

      allow create, update, delete:
        if isAdmin();
    }

    /* ============================================================
       PROGRAM DAYS
       ============================================================ */

    match /programDays/{dayId} {

      /*
       * Admins:
       * full access.
       *
       * Clients:
       * may read a day only when its programId matches
       * their current active program.
       */

      allow read:
        if isAdmin()
        || (
          hasActiveProgramMapping()
          && get(
            /databases/$(database)/documents/clientActivePrograms/$(request.auth.uid)
          ).data.programId == resource.data.programId
        );

      allow create, update, delete:
        if isAdmin();
    }

    /* ============================================================
       PROGRAM ASSIGNMENTS
       ============================================================ */

    match /programAssignments/{assignmentId} {

      /*
       * Admins:
       * full access.
       *
       * Clients:
       * read only assignments belonging to themselves.
       *
       * Clients cannot create, modify, or delete assignments.
       */

      allow read:
        if isAdmin()
        || (
          isActive()
          && resource.data.clientId == request.auth.uid
        );

      allow create, update, delete:
        if isAdmin();
    }

    /* ============================================================
       CLIENT ACTIVE PROGRAM
       ============================================================ */

    match /clientActivePrograms/{clientId} {

      /*
       * Admins:
       * full access.
       *
       * Client:
       * may read only its own current-program mapping.
       */

      allow read:
        if isAdmin()
        || (
          isActive()
          && request.auth.uid == clientId
        );

      allow create, update, delete:
        if isAdmin();
    }

    /* ============================================================
       ARIA PROGRAMS (colecciones propias de la PWA ARIA,
       separadas del modelo legacy de programas)
       ============================================================ */

    match /ariaPrograms/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /ariaProgramAssignments/{uid} {
      allow read:
        if isAdmin()
        || (signedIn() && request.auth.uid == uid);
      allow create, delete:
        if isAdmin();
      // El dueño solo puede avanzar de semana en +1, sin tocar el resto.
      allow update:
        if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.week == resource.data.week + 1
          && request.resource.data.programId == resource.data.programId
          && request.resource.data.uid == resource.data.uid
        );
    }

    /* ============================================================
       DEFAULT DENY
       ============================================================ */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
