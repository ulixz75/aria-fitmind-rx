rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function isActive() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'; }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'client'
                    && request.resource.data.status == 'pending';
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin() || (request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    match /clientProfiles/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if isAdmin() || (isActive() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    match /workoutSessions/{sessionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isActive() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (isActive() && resource.data.uid == request.auth.uid);
      match /sets/{setId} {
        allow read: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/workoutSessions/$(sessionId)).data.uid == request.auth.uid);
        allow create, update: if isAdmin() || (isActive() && get(/databases/$(database)/documents/workoutSessions/$(sessionId)).data.uid == request.auth.uid);
        allow delete: if isAdmin();
      }
    }

    match /coachConfigs/{configId} {
      allow read: if isActive() || isAdmin();
      allow write: if isAdmin();
    }
    match /exercises/{exerciseId} {
  allow read: if isAdmin() || isActive();
  allow create, update, delete: if isAdmin();
}
match /trainingPrograms/{programId} {
  allow read: if isAdmin();
  allow create, update, delete: if isAdmin();
}

match /programDays/{dayId} {
  allow read: if isAdmin();
  allow create, update, delete: if isAdmin();
}

match /programAssignments/{assignmentId} {
  allow read: if isAdmin() || (signedIn() && resource.data.clientId == request.auth.uid);
  allow create: if isActive() && request.resource.data.clientId == request.auth.uid;
  allow update, delete: if isAdmin() || (isActive() && resource.data.clientId == request.auth.uid);
}

    match /{document=**} { allow read, write: if false; }
  }
}
